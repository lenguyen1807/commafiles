{
  "lsp_document_colors": "background",
  "theme": null,
  "ssh_connections": [
    {
      "host": "prime_intellect",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ubuntu"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/zalo-ai"
          ]
        },
        {
          "paths": [
            "/workspace/zalo-ai"
          ]
        }
      ]
    },
    {
      "host": "vastai",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root"
          ]
        },
        {
          "paths": [
            "/workspace/zalo-ai"
          ]
        }
      ]
    }
  ],
  "project_panel": {
    "dock": "right"
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "error" // same values as the `diagnostics_max_severity` from the editor settings
    }
  },
  "agent": {
    "dock": "left",
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": true
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."],
      "format_on_save": "on"
    }
  },
  "disable_ai": false,
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  },
  "relative_line_numbers": true,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "base_keymap": "VSCode",
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    "font_size": 13.0
  },
  "soft_wrap": "editor_width",
  "autosave": "on_focus_change",
  "telemetry": {
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 14.0,
