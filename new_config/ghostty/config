shell-integration = zsh
command = /bin/zsh
working-directory = inherit
shell-integration-features = ssh-terminfo,ssh-env

font-family = "JetBrains Mono"
font-size = 15
font-feature = -liga
window-inherit-font-size = true

window-padding-x = 10
window-padding-y = 8
window-decoration = auto
window-theme = auto
window-save-state = always

macos-titlebar-style = tabs
macos-option-as-alt = left
macos-window-shadow = true
macos-auto-secure-input = true

copy-on-select = clipboard
clipboard-paste-protection = true

cursor-style = block
cursor-style-blink = true
cursor-color = #2f81f7
cursor-text = #0d1117

background = #0d1117
foreground = #e6edf3
selection-background = #264f78
selection-foreground = #e6edf3

palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4
palette = 8=#6e7681
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff

background-opacity = 0.92
background-blur = true

scrollback-limit = 10000000
window-step-resize = false

keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+shift+h=resize_split:left,30
keybind = super+ctrl+shift+j=resize_split:down,30
keybind = super+ctrl+shift+k=resize_split:up,30
keybind = super+ctrl+shift+l=resize_split:right,30
