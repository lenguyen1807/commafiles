prefix_rule(pattern=["/bin/zsh", "-lc", "root=$(mktemp -d /tmp/pho-phase6-live.XXXXXX); HOME=\"$root\" target/debug/pho-native >\"$root/stdout\" 2>\"$root/stderr\" & echo \"QA_ROOT=$root\"; echo \"PID=$!\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "HOME=/tmp/pho-phase6-live.PeZD6e target/debug/pho-native"], decision="allow")
prefix_rule(pattern=["/tmp/pho-cargo-audit/bin/cargo-audit", "audit"], decision="allow")
