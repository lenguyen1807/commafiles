SCRIPT_STATUS=$script_code\"; echo \"READY_CREDENTIAL_BUTTONS=$(rg -c 'Open DeepSeek credential settings' \"$root/retry-tree\")\"; echo \"RETRY_BUTTONS_AFTER=$(rg -c 'Retry opening Pho Code' \"$root/retry-tree\")\"; echo \"FIRST_STDERR_BYTES=$(wc -c <\"$root/first.err\" | tr -d ' ')\"; echo \"SECOND_STDERR_BYTES=$(wc -c <\"$root/second.err\" | tr -d ' ')\"; tail -40 \"$root/retry-tree\""], decision="allow")
